{
    "name": "@treygrr/nuxt-opentelemetry",
    "version": "0.1.0",
    "description": "OpenTelemetry tracing for Nuxt servers: starts the Node SDK before Nitro and names each request span after its Nuxt route.",
    "keywords": [
        "nuxt",
        "nuxt-module",
        "nitro",
        "opentelemetry",
        "otel",
        "tracing",
        "observability"
    ],
    "homepage": "https://github.com/treygrr/nuxt-opentelemetry#readme",
    "bugs": {
        "url": "https://github.com/treygrr/nuxt-opentelemetry/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/treygrr/nuxt-opentelemetry"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "main": "./dist/module.mjs",
    "files": [
        "dist"
    ],
    "engines": {
        "node": "^22.22.3 || >=24.11.1"
    },
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "build": "nuxt-module-build prepare && nuxt-module-build build",
        "dev": "nuxt dev playground",
        "dev:build": "nuxt build playground",
        "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
        "fmt": "prettier --check src test playground scripts prettier.config.mjs",
        "fmt:fix": "prettier --write src test playground scripts prettier.config.mjs",
        "test": "pnpm build && vitest run",
        "typecheck": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && vue-tsc --noEmit",
        "release": "node scripts/release.mjs",
        "prepack": "pnpm build"
    },
    "dependencies": {
        "@nuxt/kit": "^4.6.0",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/auto-instrumentations-node": "^0.82.0",
        "@opentelemetry/core": "^3.0.0",
        "@opentelemetry/sdk-node": "^0.300.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "import-in-the-middle": "^3.5.2"
    },
    "devDependencies": {
        "@nuxt/module-builder": "1.0.3",
        "@nuxt/schema": "4.6.2",
        "@types/node": "24.13.6",
        "nuxt": "4.6.2",
        "prettier": "3.9.9",
        "typescript": "6.0.3",
        "vitest": "5.0.5",
        "vue": "3.5.44",
        "vue-tsc": "3.3.13"
    },
    "publishConfig": {
        "access": "public"
    }
}
